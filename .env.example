# Run taskforge init to create private admin and reviewer tokens.
TASKFORGE_STORAGE_URL=sqlite+aiosqlite:///taskforge.db
TASKFORGE_DATA_DIR=.taskforge
TASKFORGE_HOST=127.0.0.1
TASKFORGE_PORT=8080
TASKFORGE_LOG_LEVEL=info
TASKFORGE_METRICS_ENABLED=true
TASKFORGE_ALLOW_HOST_EXECUTION=false
TASKFORGE_WORKER_CONCURRENCY=2
TASKFORGE_LEASE_SECONDS=30
TASKFORGE_CORS_ORIGINS=[]
TASKFORGE_GITHUB_REPOSITORIES=[]
TASKFORGE_ALLOWED_HTTP_HOSTS=[]
TASKFORGE_DEPLOYMENT_TARGETS={}
# Project secret values belong in a protected runner-only environment:
# TASKFORGE_SECRETS={"default/EXAMPLE_TOKEN":"real-value"}
